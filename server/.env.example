# Copy this to Railway's "Variables" tab for the voice server service - never commit real values.

ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+13527478676

ABEL_CELL_NUMBER=+18457216997

# Email alerts are OFF by default - just text alerts while it's you testing.
# Flip to "true" and fill in the three lines below once you have a paying customer.
ENABLE_EMAIL_ALERTS=false
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ABEL_EMAIL=you@example.com
FROM_EMAIL=alerts@yourdomain.com

# Set this AFTER your first Railway deploy, to the URL Railway gives you (no https://, no trailing slash)
PUBLIC_HOSTNAME=abel-ai-answering-production.up.railway.app

PORT=3000
